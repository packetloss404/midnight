{
  "branches": [
    {
      "pattern": "main",
      "required_status_checks": [],
      "required_pull_request_reviews": 1,
      "require_code_owner_reviews": true,
      "require_linear_history": true,
      "allow_force_pushes": false,
      "allow_deletions": false
    },
    {
      "pattern": "release/*",
      "required_status_checks": [],
      "required_pull_request_reviews": 2,
      "require_code_owner_reviews": true,
      "require_linear_history": true,
      "allow_force_pushes": false,
      "allow_deletions": false
    }
  ]
}
