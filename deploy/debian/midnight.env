# Midnight package defaults for the single-server MVP install path.
# Operators edit /etc/midnight/midnight.env in place after package install.

# Control plane.
MIDNIGHT_CONFIG=/etc/midnight/config.yml
MIDNIGHT_STORAGE=postgres
MIDNIGHT_SERVER_ADDR=127.0.0.1:8080
MIDNIGHT_SERVER_URL=http://127.0.0.1:8080
# postinst replaces this empty value with a cryptographically random token.
# Keep the name shared across server and agent control-plane requests.
MIDNIGHT_API_BEARER_TOKEN=
# The console is compiled into midnight-server, so nothing needs configuring
# here. The package also installs the same bundle at
# /usr/share/midnight/web-next; uncomment below to serve that directory (or any
# other) instead of the embedded one. The override is authoritative: if it is
# set and unusable, the server serves an explicit "console unavailable" page
# rather than silently falling back.
# MIDNIGHT_WEB_DIST_DIR=/usr/share/midnight/web-next
# Shared staging area for `midnight up`. Server and build worker both use
# PrivateTmp, so uploaded local:// sources must live in durable shared state.
MIDNIGHT_UP_EXTRACTION_ROOT=/var/lib/midnight/uploads
# Content-addressed and retained legacy upload cleanup. The build worker
# validates that work retention safely exceeds execution timeout plus lease
# duration before it starts.
MIDNIGHT_SOURCE_ARTIFACT_GC_INTERVAL=15m
MIDNIGHT_SOURCE_ARTIFACT_GC_TIMEOUT=30s
MIDNIGHT_SOURCE_ARTIFACT_RETENTION=24h
MIDNIGHT_SOURCE_ARTIFACT_REFERENCE_RETENTION=24h
MIDNIGHT_SOURCE_ARTIFACT_WORK_RETENTION=24h
MIDNIGHT_SOURCE_ARTIFACT_QUARANTINE_RETENTION=1h
MIDNIGHT_SOURCE_ARTIFACT_GC_MAX_ITEMS=128
MIDNIGHT_SOURCE_ARTIFACT_GC_MAX_VERIFY_BYTES=134217728
# Logical retained human-upload quota and replica-safe pre-body backpressure.
# Keep these values identical for the API and build worker.
MIDNIGHT_SOURCE_ARTIFACT_WORKSPACE_QUOTA_BYTES=5368709120
MIDNIGHT_SOURCE_ARTIFACT_WORKSPACE_INFLIGHT_BYTES=209715200
MIDNIGHT_SOURCE_ARTIFACT_WORKSPACE_INFLIGHT_COUNT=4
MIDNIGHT_SOURCE_ARTIFACT_GLOBAL_INFLIGHT_BYTES=1073741824
MIDNIGHT_SOURCE_ARTIFACT_GLOBAL_INFLIGHT_COUNT=32
MIDNIGHT_SOURCE_ARTIFACT_UPLOAD_LEASE=10m
MIDNIGHT_SOURCE_ARTIFACT_ORPHAN_CHARGE_RETENTION=26h

# Worker runtime. The packaged profile uses Docker Engine on the same host.
# Leave MIDNIGHT_WORKER_DOCKER_HOST empty to let the Docker SDK use DOCKER_HOST
# or its default local socket. Set it to unix:///var/run/docker.sock only when
# the operator wants the socket path pinned in this file.
MIDNIGHT_WORKER_ID=midnight-worker
MIDNIGHT_WORKER_RUNTIME_BACKEND=docker
MIDNIGHT_WORKER_DOCKER_HOST=
MIDNIGHT_WORKER_AGENT_ID=local-agent
MIDNIGHT_WORKER_HOST_ID=local-agent
MIDNIGHT_WORKER_RECLAIM_INTERVAL=30s
MIDNIGHT_WORKER_POLL_INTERVAL=2s
MIDNIGHT_WORKER_LEASE_TTL=5m

# Signed audit checkpoints. Retain the worker key across upgrades/backups.
# Trust is an explicit operator decision: pin public-only keys in this
# root-managed directory before treating signed audit evidence as verified.
MIDNIGHT_AUDIT_CHECKPOINT_ENABLED=true
MIDNIGHT_AUDIT_SIGNING_KEY_PATH=/var/lib/midnight/audit/signing-key.pem
MIDNIGHT_AUDIT_TRUSTED_PUBLIC_KEY_DIR=/etc/midnight/audit-trusted-keys

# Worker image trust. The packaged default accepts only immutable sha256 image
# digests from the configured loopback registry. External images fail closed
# unless cosign verification or an operator-managed static allowlist is set.
MIDNIGHT_WORKER_VERIFY_SIGNATURES=false
MIDNIGHT_WORKER_COSIGN_BINARY_PATH=
MIDNIGHT_WORKER_COSIGN_PUBLIC_KEY=
MIDNIGHT_WORKER_COSIGN_CERTIFICATE_IDENTITY_REGEXP=
MIDNIGHT_WORKER_COSIGN_CERTIFICATE_OIDC_ISSUER=
MIDNIGHT_WORKER_COSIGN_FULCIO_ROOT=
MIDNIGHT_WORKER_COSIGN_VERIFY_TIMEOUT=30s
# Trust only immutable sha256 image digests produced by the packaged loopback
# registry. External registries still require cosign or a static allowlist.
MIDNIGHT_WORKER_TRUST_LOCAL_REGISTRY=true
# MIDNIGHT_WORKER_TRUSTED_IMAGES=registry.example.com/app@sha256:...

# Worker route publication. The installer creates this directory as
# midnight:midnight 0750; Traefik's file provider must watch the same path.
# Public capability remains unavailable until these operator-owned values are
# set. Generated names use one collision-resistant label below APPS_DOMAIN.
MIDNIGHT_WORKER_ROUTE_CONFIG_DIR=/etc/midnight/traefik/dynamic
MIDNIGHT_WORKER_ROUTE_GROUP=default
MIDNIGHT_APPS_DOMAIN=
# Route publication is only accepted once Traefik itself acknowledges the
# router, so the worker reads Traefik's own API. Point this at the operator's
# Traefik API entrypoint, which MUST NOT be midnight-server's listen address:
# the previous default (127.0.0.1:8080) is the Midnight API, so every
# verification probed the control plane instead of Traefik and failed with a
# 404 that named neither. Traefik needs a matching `api:` section and an
# entryPoint bound to this address; see docs/install/operator-install-path.md.
MIDNIGHT_WORKER_TRAEFIK_API_URL=http://127.0.0.1:8090
MIDNIGHT_WORKER_INGRESS_PROBE_URL=http://127.0.0.1:80
# Empty selects host-ingress mode, which is how this package installs Traefik:
# a systemd service that already reaches container addresses directly and has
# nothing to enroll into the per-environment bridges. Set it to a container
# name only when the ingress itself runs as a container.
MIDNIGHT_WORKER_INGRESS_CONTAINER=
MIDNIGHT_WORKER_ROUTE_PUBLIC_HOST=
MIDNIGHT_WORKER_ROUTE_PUBLIC_PATH=/
MIDNIGHT_WORKER_ROUTE_PUBLIC_TLS=false
MIDNIGHT_WORKER_ROUTE_CERT_RESOLVER=
MIDNIGHT_WORKER_ROUTE_TARGET_PORT=8080

# Optional provider-neutral DNS reconciliation. Planning is enabled separately
# from apply so a newly configured zone starts in mutation-free dry-run mode.
# Put CLOUDFLARE_DNS_API_TOKEN in /etc/midnight/cloudflare.env (mode 0600,
# root-owned), never in this shared environment file.
MIDNIGHT_WORKER_DNS_ENABLED=false
MIDNIGHT_WORKER_DNS_PROVIDER=cloudflare
MIDNIGHT_WORKER_DNS_ZONE_ID=
MIDNIGHT_WORKER_DNS_ZONE_NAME=
MIDNIGHT_WORKER_DNS_ROUTE_TARGET=
MIDNIGHT_WORKER_DNS_IPV4=
MIDNIGHT_WORKER_DNS_IPV6=
MIDNIGHT_WORKER_DNS_TTL=300
MIDNIGHT_WORKER_DNS_APPLY=false
MIDNIGHT_WORKER_DNS_RECONCILE_INTERVAL=30s
MIDNIGHT_WORKER_DNS_HTTP_TIMEOUT=10s

# Agent and local paths.
MIDNIGHT_AGENT_ID=local-agent
# Production server keyring and agent-local credential. The installer or
# operator provisions both with independent high-entropy material.
MIDNIGHT_AGENT_CREDENTIALS_FILE=/etc/midnight/agent-credentials.json
MIDNIGHT_AGENT_CREDENTIAL_FILE=/etc/midnight/agent.credential
# Shared compatibility input. Leave empty outside explicit local development.
MIDNIGHT_AGENT_HMAC_SECRET=
MIDNIGHT_RUNTIME_ROOT=/var/lib/midnight/agent
MIDNIGHT_SHUTDOWN_DEADLINE=30s
MIDNIGHT_DATA_DIR=/var/lib/midnight
MIDNIGHT_LOG_DIR=/var/log/midnight
# Traefik JSON access-log collector. The installer creates the parent as
# root:midnight 2770; replacement access logs inherit group midnight.
MIDNIGHT_TRAEFIK_ACCESS_LOG_PATH=/var/log/midnight/traefik/access.jsonl
MIDNIGHT_RUN_DIR=/run/midnight

# Postgres DSN. Prefer writing the secret DSN as a single line in this file path
# (mode 0640 root:midnight). MIDNIGHT_DB_DSN, when set externally, wins over the
# file fallback and should not be added here unless an operator accepts the leak
# risk of putting secrets in a shared EnvironmentFile.
MIDNIGHT_DB_DSN_FILE=/etc/midnight/db.dsn
MIDNIGHT_CURSOR_KEY_PATH=/etc/midnight/cursor.key
MIDNIGHT_AUTOMATION_TOKEN_KEY_PATH=/etc/midnight/automation-token.key
MIDNIGHT_INVITATION_KEY_PATH=/etc/midnight/invitation.key
MIDNIGHT_VARIABLE_INTENT_KEY_PATH=/etc/midnight/variable-intent.key
MIDNIGHT_KEK_PATH=/etc/midnight/kek

# Optional operator-owned GitHub App. The server uses all three values for
# installation discovery and webhook verification. The build worker receives
# only APP_ID + PRIVATE_KEY_PATH and mints a short-lived installation token in
# memory immediately before private-repository checkout.
# MIDNIGHT_GITHUB_APP_ID=
# MIDNIGHT_GITHUB_PRIVATE_KEY_PATH=/etc/midnight/github-app.pem
# MIDNIGHT_GITHUB_WEBHOOK_SECRET=
# MIDNIGHT_GITHUB_WEBHOOK_ENDPOINT_ID=github
# MIDNIGHT_GITHUB_API_BASE_URL=https://api.github.com
# Browser setup/OAuth. Configure all four on the server or leave all four unset.
# MIDNIGHT_GITHUB_CLIENT_ID=
# MIDNIGHT_GITHUB_CLIENT_SECRET=
# MIDNIGHT_GITHUB_APP_SLUG=midnight-self-hosted
# MIDNIGHT_GITHUB_CALLBACK_URL=https://midnight.example.com/api/v1alpha/github/setup/callback
# GHES only; public GitHub defaults to https://github.com.
# MIDNIGHT_GITHUB_WEB_BASE_URL=https://github.example.com
# MIDNIGHT_GITHUB_CLONE_HOST=github.com
# MIDNIGHT_GITHUB_STATUS_POLL_INTERVAL=5s
# MIDNIGHT_GITHUB_STATUS_BATCH_SIZE=25
# MIDNIGHT_GITHUB_STATUS_LEASE_DURATION=30s

# Local registry and BuildKit. The Midnight package installs service wrappers;
# operators must provide pinned upstream registry/buildkitd/buildctl binaries at
# absolute paths. Keep registry bound to loopback for the single-server profile.
# ADDR is the registry listener while ENDPOINT is the build worker's push
# target. They are the same loopback address in the single-server profile.
MIDNIGHT_REGISTRY_ADDR=127.0.0.1:5000
MIDNIGHT_REGISTRY_ENDPOINT=127.0.0.1:5000
MIDNIGHT_REGISTRY_INSECURE=true
MIDNIGHT_REGISTRY_BIN=/usr/local/bin/registry
MIDNIGHT_REGISTRY_CONFIG=/etc/midnight/registry.yml
MIDNIGHT_BUILDKIT_ADDR=unix:///run/midnight/buildkit/buildkitd.sock
MIDNIGHT_BUILDKIT_GROUP=midnight
MIDNIGHT_BUILDCTL=/usr/local/bin/buildctl
MIDNIGHT_BUILDKITD_BIN=/usr/local/bin/buildkitd
MIDNIGHT_BUILDKIT_ROOT=/var/lib/midnight/buildkit

# Optional off-host backup destination. When set, midnight-doctor
# --mvp-readiness verifies that the URI uses a supported off-host provider.
# MIDNIGHT_BACKUP_DESTINATION_URI=s3://bucket/prefix
