[Unit]
Description=Midnight source build queue worker
Documentation=https://github.com/midnight/midnight
After=network-online.target postgresql.service midnight-server.service midnight-buildkit.service midnight-registry.service
Requires=midnight-buildkit.service midnight-registry.service
Wants=network-online.target

[Service]
Type=simple
User=midnight
Group=midnight
EnvironmentFile=-/etc/midnight/midnight.env
ExecStart=/usr/bin/midnight-buildkit worker
Restart=on-failure
RestartSec=5s
StateDirectory=midnight/build
StateDirectory=midnight/uploads
LogsDirectory=midnight
RuntimeDirectory=midnight/build-worker
# Shares the /run/midnight parent with the server, worker and registry
# units; preserving it keeps a sibling restart from removing this socket.
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
