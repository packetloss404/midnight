# Example only. Copy outside Git and chmod 0600. No production CA option exists.
TARGET_CLASS=disposable-qa
DNS_ZONE_ID=00000000000000000000000000000000
DNS_ZONE_NAME=example.invalid
DNS_QA_SUFFIX=midnight-qa.example.invalid
CLOUDFLARE_TOKEN_FILE=cloudflare-qa.token
ACME_EMAIL=qa@example.invalid
# Existing native-issuer LE staging account directory, mode 0700, containing
# account.key and registration.json (both 0600). This runner creates no account.
ACME_STAGING_ACCOUNT_DIR=existing-staging-account
DEADLINE_SECONDS=900
ACK_EXTERNAL_MUTATIONS=disposable-scopes-only
ACK_DNS_MUTATIONS=staging-disposable-subdomain-only
