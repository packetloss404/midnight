# Example only. Copy outside Git and chmod the copy and token file to 0600.
# Configure the QA server for this exact provider/model; no API keys go here.
TARGET_CLASS=disposable-qa
QA_API_BASE=https://qa.midnight.example.invalid
QA_EXPECTED_COMMIT=0000000000000000000000000000000000000000
QA_WORKSPACE_ID=ws_disposable_qa
QA_PROJECT_ID=prj_disposable_qa
QA_SERVICE_ID=svc_disposable_qa
QA_ENVIRONMENT_ID=env_disposable_qa
QA_HUMAN_TOKEN_FILE=human-session.token
PROVIDER=openai
MODEL=replace-with-explicit-provider-model
DEADLINE_SECONDS=600
# Required only with --execute; this authorizes the exact disposable scope.
ACK_EXTERNAL_MUTATIONS=disposable-scopes-only
ACK_PAID_CALLS=allow-bounded-calls
# Add for --lane diagnosis: an operator-provided immutable image that fails
# during a real deployment. It must be allowed by the QA worker image policy.
# DIAGNOSIS_IMAGE=registry.example.invalid/qa/failing@sha256:<64-lowercase-hex>
