# Example only. Copy outside Git; all credential files and this copy need 0600.
TARGET_CLASS=disposable-qa
QA_API_BASE=https://qa.midnight.example.invalid
QA_EXPECTED_COMMIT=0000000000000000000000000000000000000000
QA_WORKSPACE_ID=ws_disposable_qa
QA_PROJECT_ID=prj_disposable_qa
QA_SERVICE_ID=svc_disposable_qa
QA_ENVIRONMENT_ID=env_disposable_qa
QA_HUMAN_TOKEN_FILE=human-session.token
# Pre-existing product App installation and human workspace grant/source link.
GITHUB_APP_ID=1
GITHUB_INSTALLATION_ID=1
GITHUB_APP_SLUG=midnight-qa-example
GITHUB_PRIVATE_KEY_FILE=product-app.pem
GITHUB_REPOSITORY_ID=1
GITHUB_REPOSITORY=qa-owner/disposable-midnight-qa
GITHUB_QA_BRANCH=qa-midnight-acceptance
GITHUB_EXPECTED_HEAD=0000000000000000000000000000000000000000
GITHUB_STATUS_CONTEXT=midnight/deploy
# Separate fine-grained QA driver: contents/PR write on this repository only.
# This does not replace the product App installation or grant handshake.
GITHUB_QA_DRIVER_LOGIN=qa-driver-example
GITHUB_QA_DRIVER_TOKEN_FILE=qa-driver.token
DEADLINE_SECONDS=900
ACK_EXTERNAL_MUTATIONS=disposable-scopes-only
# Optional read-only runtime proof; target, key, and known-hosts are required.
# QA_RUNTIME_SSH_TARGET=qa-observer@runtime.example.invalid
# QA_RUNTIME_SSH_PORT=22
# QA_RUNTIME_SSH_KEY_FILE=runtime-observer.key
# QA_RUNTIME_SSH_KNOWN_HOSTS_FILE=runtime-known-hosts
# QA_RUNTIME_SSH_SUDO=true
